{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Hourly game push. Later plans append crons; do not replace this array.
  "triggers": { "crons": ["5 * * * *", "50 11 * * *", "0 12 * * *"] },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/rt/*", "/.env*", "/.git/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "METER", "class_name": "Meter" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  // Workers Rate Limiting bindings, keyed by client IP in worker.js (rateOk). Counts are per Cloudflare location and approximate.
  // namespace_id only has to be unique within the Cloudflare account. period must be 10 or 60 (seconds).
  "ratelimits": [
    // new guests minted by POST /rt/guest (renewals and handovers are not counted), keyed by network: IPv4 as is, IPv6 by its /64
    { "name": "GUEST_RL", "namespace_id": "4701", "simple": { "limit": 10, "period": 60 } },
    // POST /rt/event (and the plaza's ad counts, POST /rt/ads/click and /rt/ads/seen: key 'adhit:<network>')
    { "name": "EVENT_RL", "namespace_id": "4702", "simple": { "limit": 600, "period": 60 } },
    // POST /rt/err, POST /rt/support, GET /rt/health, POST /rt/ads/request, GET /rt/ads/report/* (ops.js opsRate; one key per route and
    // network, IPv6 by /64), and the ad counts per account ('adact:<account>')
    { "name": "OPS_RL", "namespace_id": "4711", "simple": { "limit": 20, "period": 60 } },
    // per account, not per IP (bot protection, docs/bot-protection.md): 'ws:<account>' socket joins, 'plaza:<account>' the plaza's writes,
    // 'misc:<account>' push, report, inbox read, profile and equip writes, photo upload, /rt/grp
    { "name": "ACT_RL", "namespace_id": "4712", "simple": { "limit": 60, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Meter", "Room"] }
  ]
}
